{
  "info": {
    "name": "Payment Service",
    "description": "API collection for Payment Transfer Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountNumber\": \"RS123456789\",\n  \"initialBalance\": 1000,\n  \"currency\": \"EUR\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/accounts",
          "host": ["http://localhost:8080"],
          "path": ["api", "accounts"]
        }
      }
    },
    {
      "name": "Get All Accounts",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/accounts",
          "host": ["http://localhost:8080"],
          "path": ["api", "accounts"]
        }
      }
    },
    {
      "name": "Get Account By Id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/accounts/1",
          "host": ["http://localhost:8080"],
          "path": ["api", "accounts", "1"]
        }
      }
    },
    {
      "name": "Transfer Funds",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceAccountId\": 1,\n  \"destinationAccountId\": 2,\n  \"amount\": 100\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/transfers",
          "host": ["http://localhost:8080"],
          "path": ["api", "transfers"]
        }
      }
    },
    {
      "name": "Get All Transfers",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/transfers",
          "host": ["http://localhost:8080"],
          "path": ["api", "transfers"]
        }
      }
    },
    {
      "name": "Get Transfers For Account",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/transfers/account/1",
          "host": ["http://localhost:8080"],
          "path": ["api", "transfers", "account", "1"]
        }
      }
    }
  ]
}
